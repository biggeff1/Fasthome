{
  "name": "Fasthome",
  "features": {
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.12"
    }
  },
  "containerEnv": {
    "DJANGO_DEBUG": "1",
    "DJANGO_ALLOWED_HOSTS": "localhost,127.0.0.1"
  },
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "Fasthome Django",
      "onAutoForward": "openBrowser"
    }
  }
}
